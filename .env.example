# Local development token shared by the EwE plugin and Python MCP server.
# Override this before doing anything beyond local smoke tests.
EWE_MCP_TOKEN=ewe-mcp-local-dev

# The plugin defaults to 127.0.0.1:9877 to avoid colliding with qgis-mcp.
EWE_MCP_HOST=127.0.0.1
EWE_MCP_PORT=9877

# Optional: enable the dangerous escape hatch. Leave disabled by default.
EWE_MCP_ENABLE_EVAL=0

# Optional VM helpers. Keep the actual password in your shell, not this file:
# export SSHPASS='...'
EWE_VM_HOST=192.168.64.2
EWE_VM_USER=dexter
EWE_VM_PLUGIN_DIR='C:\Path\To\EwE\plugins'
EWE_VM_EWE_DIR='C:\Path\To\EwE'
