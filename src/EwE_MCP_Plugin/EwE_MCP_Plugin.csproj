<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <AssemblyName>EwE_MCP_Plugin</AssemblyName>
    <RootNamespace>EwE_MCP_Plugin</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <EwEAssemblyDir Condition="'$(EwEAssemblyDir)' == ''">/Users/dexterfichuk/Downloads/Eii.Ecopath-master/Sources</EwEAssemblyDir>
    <EwEAssemblyConfiguration Condition="'$(EwEAssemblyConfiguration)' == ''">Release</EwEAssemblyConfiguration>
    <EwEAssemblyPlatform Condition="'$(EwEAssemblyPlatform)' == ''">x86</EwEAssemblyPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <EwECoreAssemblyDir>$(EwEAssemblyDir)/EwECore/bin/$(EwEAssemblyPlatform)/$(EwEAssemblyConfiguration)</EwECoreAssemblyDir>
    <EwEUtilsAssemblyDir>$(EwEAssemblyDir)/EwEUtils/bin/$(EwEAssemblyPlatform)/$(EwEAssemblyConfiguration)</EwEUtilsAssemblyDir>
    <ScientificInterfaceSharedAssemblyDir>$(EwEAssemblyDir)/ScientificInterfaceShared/bin/$(EwEAssemblyPlatform)/$(EwEAssemblyConfiguration)</ScientificInterfaceSharedAssemblyDir>
    <EwECoreAssemblyPath Condition="Exists('$(EwEAssemblyDir)/EwECore.dll')">$(EwEAssemblyDir)/EwECore.dll</EwECoreAssemblyPath>
    <EwECoreAssemblyPath Condition="'$(EwECoreAssemblyPath)' == ''">$(EwECoreAssemblyDir)/EwECore.dll</EwECoreAssemblyPath>
    <EwEPluginAssemblyPath Condition="Exists('$(EwEAssemblyDir)/EwEPlugin.dll')">$(EwEAssemblyDir)/EwEPlugin.dll</EwEPluginAssemblyPath>
    <EwEPluginAssemblyPath Condition="'$(EwEPluginAssemblyPath)' == ''">$(EwECoreAssemblyDir)/EwEPlugin.dll</EwEPluginAssemblyPath>
    <EwEUtilsAssemblyPath Condition="Exists('$(EwEAssemblyDir)/EwEUtils.dll')">$(EwEAssemblyDir)/EwEUtils.dll</EwEUtilsAssemblyPath>
    <EwEUtilsAssemblyPath Condition="'$(EwEUtilsAssemblyPath)' == ''">$(EwEUtilsAssemblyDir)/EwEUtils.dll</EwEUtilsAssemblyPath>
    <ScientificInterfaceSharedAssemblyPath Condition="Exists('$(EwEAssemblyDir)/ScientificInterfaceShared.dll')">$(EwEAssemblyDir)/ScientificInterfaceShared.dll</ScientificInterfaceSharedAssemblyPath>
    <ScientificInterfaceSharedAssemblyPath Condition="'$(ScientificInterfaceSharedAssemblyPath)' == ''">$(ScientificInterfaceSharedAssemblyDir)/ScientificInterfaceShared.dll</ScientificInterfaceSharedAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="._*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EwECore">
      <HintPath>$(EwECoreAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="EwEPlugin">
      <HintPath>$(EwEPluginAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="EwEUtils">
      <HintPath>$(EwEUtilsAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ScientificInterfaceShared">
      <HintPath>$(ScientificInterfaceSharedAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
